APP_NAME=Case Prep API
APP_ENV=staging
APP_DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
COMPOSE_PROJECT_NAME=caseprep-staging
FRONTEND_APP_URL=https://caseprep-staging.local

POSTGRES_DB=caseprep
POSTGRES_USER=caseprep
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000

DATABASE_URL=postgresql+asyncpg://caseprep:change-me@postgres:5432/caseprep
ALEMBIC_DATABASE_URL=postgresql+psycopg://caseprep:change-me@postgres:5432/caseprep
REDIS_URL=redis://redis:6379/0

LOCAL_STORAGE_PATH=/app/storage/uploads
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=/app/storage/documents
DOCUMENT_MAX_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

DOCUMENT_PROCESSING_AUTO_ENQUEUE=true
DOCUMENT_PROCESSING_QUEUE_NAME=document-processing
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
DOCUMENT_PROCESSING_WORKER_POLL_TIMEOUT=5

TESSERACT_COMMAND=tesseract
OCR_MYPDF_COMMAND=ocrmypdf
DOCUMENT_OCR_LANGUAGE=eng+spa
DOCUMENT_EMBEDDED_TEXT_MIN_CHARS=30

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_NAME=Case Prep Staff
NEXT_PUBLIC_AUTH_MODE=mock
NEXT_PUBLIC_KEYCLOAK_ISSUER=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=
NEXT_PUBLIC_DEFAULT_ROLE=paralegal
NEXT_PUBLIC_DEFAULT_USER_NAME=Internal Staff
NEXT_PUBLIC_DEFAULT_USER_EMAIL=staff@example.com
